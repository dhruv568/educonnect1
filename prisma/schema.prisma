// EduConnects Database Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  passwordHash          String
  role                  String              @default("STUDENT") // ADMIN | STAFF | TEACHER | STUDENT
  roleId                String?
  status                String              @default("ACTIVE") // ACTIVE | SUSPENDED | DEACTIVATED
  emailVerified         Boolean             @default(false)
  emailVerifiedAt       DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  customRole            Role?               @relation("UserRole", fields: [roleId], references: [id], onDelete: SetNull)
  rolesCreated          Role[]              @relation("RolesCreatedBy")
  staffInvitationsSent  StaffInvitation[]   @relation("StaffInvitedBy")
  profile               Profile?
  teacherProfile        TeacherProfile?
  studentProfile        StudentProfile?
  emailVerifications    EmailVerification[]
  phoneVerifications    PhoneVerification[]
  passwordResets        PasswordReset[]
  auditLogs             AuditLog[]
  verificationDecisions TeacherVerificationHistory[] @relation("AdminDecisions")
  adminNotes            AdminNote[]                  @relation("AdminNotesCreated")
  bookings              Booking[]
  attendances           ClassAttendance[]
  classroomMessages     ClassroomMessage[]
  classroomFiles        ClassroomFile[]
  enrollments           Enrollment[]
  courseReviews         CourseReview[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  activityLogs          ActivityLog[]
  paymentOrders         PaymentOrder[]
  paymentTransactions   PaymentTransaction[]
  refundsRequested      Refund[]                     @relation("RefundRequestedBy")
  reportsCreated        Report[]                     @relation("ReportedBy")
  reportsResolved       Report[]                     @relation("ReportResolvedBy")
  courseModerations     CourseModerationHistory[]    @relation("CourseModerationAdmin")
  aiConversations       AiConversation[]
  trainingEnrollments   TrainingEnrollment[]
  certificates          Certificate[]
  whatsappMessages      WhatsAppMessage[]

  @@index([role, status])
  @@index([status])
  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  avatarUrl String?
  phone     String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model TeacherProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  headline           String?
  bio                String?
  contactPhone       String?
  location           String?
  subjects           String?  // Comma-separated or JSON list of subjects
  experienceYears    Int      @default(0)
  hourlyRate         Float?
  qualifications     String?
  languages          String?  @default("English")
  teachingMode       String?  @default("ONLINE") // ONLINE | OFFLINE | BOTH
  verificationStatus String   @default("PENDING") // PENDING | VERIFIED | REJECTED | SUSPENDED
  isSeededProfile    Boolean  @default(false)
  rating             Float    @default(5.0)

  submittedAt        DateTime?
  verifiedAt         DateTime?
  rejectedAt         DateTime?
  suspendedAt        DateTime?
  rejectionReason    String?
  suspensionReason   String?

  accountHolderName  String?
  accountNumber      String?
  bankName           String?
  ifscCode           String?
  cancelledChequeUrl String?
  upiId              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses               Course[]
  teacherQualifications TeacherQualification[]
  teacherCertificates   TeacherCertificate[]
  teacherDocuments      TeacherDocument[]
  verificationHistories TeacherVerificationHistory[]
  adminNotes            AdminNote[]
  liveClassSlots        LiveClassSlot[]
  liveClassSessions     LiveClassSession[]
  availabilities        TeacherAvailability[]
  dateOverrides         TeacherDateOverride[]
  breaks                TeacherBreak[]
  payoutAccount         TeacherPayoutAccount?
  payouts               TeacherPayout[]
  ledgerEntries         FinancialLedgerEntry[]
  withdrawals           WithdrawalRequest[]

  @@index([verificationStatus])
  @@map("teacher_profiles")
}

model TeacherQualification {
  id             String         @id @default(uuid())
  teacherId      String
  degree         String
  institution    String
  specialization String?
  year           Int
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_qualifications")
}

model TeacherCertificate {
  id          String         @id @default(uuid())
  teacherId   String
  name        String
  issuer      String
  issueDate   DateTime
  expiryDate  DateTime?
  documentId  String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_certificates")
}

model TeacherDocument {
  id          String         @id @default(uuid())
  teacherId   String
  category    String         // IDENTITY | QUALIFICATION | CERTIFICATE | EXPERIENCE | OTHER
  fileName    String
  fileType    String
  fileSize    Int
  storageKey  String         @unique
  status      String         @default("ACTIVE") // ACTIVE | ARCHIVED
  uploadedAt  DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_documents")
}

model TeacherVerificationHistory {
  id             String         @id @default(uuid())
  teacherId      String
  adminId        String?
  previousStatus String
  newStatus      String
  reason         String?
  metadata       String?        // JSON string
  createdAt      DateTime       @default(now())

  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  admin          User?          @relation("AdminDecisions", fields: [adminId], references: [id], onDelete: SetNull)

  @@map("teacher_verification_histories")
}

model AdminNote {
  id        String         @id @default(uuid())
  teacherId String
  adminId   String
  content   String
  createdAt DateTime       @default(now())

  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  admin     User           @relation("AdminNotesCreated", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_notes")
}

model StudentProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  educationType       String?  // "SCHOOL" | "DIPLOMA"
  gradeLevel          String?  // "Grade 1" .. "Grade 12"
  stream              String?  // "Science", "Commerce", "Arts/Humanities", "Other" (Grades 11-12)
  competitiveExam     String?  // "JEE", "NEET", "CUET", etc. (Grades 11-12, optional)
  diplomaBranch       String?  // "Computer Engineering", etc. (Diploma)
  interests           String?
  learningPreferences String? // Comma-separated preference tags
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String    // Hashed 6-digit OTP
  tokenHash  String    @unique // Hashed URL token
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PhoneVerification {
  id         String    @id @default(uuid())
  userId     String?
  phone      String
  reqId      String?
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  attempts   Int       @default(0)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([userId])
  @@map("phone_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String   // e.g. USER_REGISTERED, LOGIN_SUCCESS, EMAIL_VERIFIED
  metadata  String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Course {
  id               String          @id @default(uuid())
  title            String
  slug             String          @unique
  subtitle         String?
  description      String
  subject          String
  category         String?         @default("General")
  gradeLevel       String?
  level            String          @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  language         String          @default("English")
  price            Float           @default(0.0)
  rating           Float           @default(5.0)
  reviewCount      Int             @default(0)
  lessonCount      Int             @default(0)
  durationHours    Float           @default(0.0)
  enrollmentCount  Int             @default(0)
  thumbnailUrl     String?
  status           String          @default("DRAFT") // DRAFT | PUBLISHED | UNPUBLISHED | ARCHIVED
  learningOutcomes String?         // JSON string or newline list
  requirements     String?         // JSON string or newline list
  publishedAt      DateTime?
  teacherId        String

  teacher          TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sections         CourseSection[]
  enrollments      Enrollment[]
  reviews          CourseReview[]
  paymentOrders    PaymentOrder[]
  paymentTransactions PaymentTransaction[]
  moderationHistories CourseModerationHistory[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([teacherId, status])
  @@index([category])
  @@map("courses")
}

model CourseSection {
  id          String         @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]

  @@map("course_sections")
}

model CourseLesson {
  id              String           @id @default(uuid())
  sectionId       String
  title           String
  description     String?
  type            String           @default("VIDEO") // VIDEO | TEXT | RESOURCE
  videoProvider   String?          @default("LOCAL") // LOCAL | STREAM | MUX | CLOUDINARY
  videoAssetId    String?
  videoUrl        String?
  durationSeconds Int              @default(0)
  order           Int              @default(0)
  isPreview       Boolean          @default(false)
  status          String           @default("READY") // UPLOADING | PROCESSING | READY | FAILED
  content         String?          // Text lesson content if type == TEXT

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  section         CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources       CourseResource[]
  progresses      LessonProgress[]
  videoAssets     VideoAsset[]

  @@map("course_lessons")
}

model VideoAsset {
  id              String        @id @default(uuid())
  lessonId        String?
  provider        String        @default("MUX") // MUX | LOCAL | CLOUDINARY
  providerAssetId String?       @unique
  uploadId        String        @unique
  playbackId      String?
  status          String        @default("UPLOADING") // UPLOADING | PROCESSING | READY | FAILED
  duration        Float?
  width           Int?
  height          Int?
  aspectRatio     String?
  thumbnailUrl    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lesson          CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("video_assets")
}

model CourseResource {
  id         String       @id @default(uuid())
  lessonId   String
  name       String
  storageKey String       @unique
  mimeType   String
  size       Int
  createdAt  DateTime     @default(now())

  lesson     CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("course_resources")
}

model Enrollment {
  id               String            @id @default(uuid())
  studentId        String
  courseId         String
  status           String            @default("ACTIVE") // PAYMENT_PENDING | ACTIVE | PAYMENT_FAILED | CANCELLED | COMPLETED | EXPIRED
  enrolledAt       DateTime          @default(now())
  completedAt      DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]
  reviews          CourseReview[]
  completion       CourseCompletion?
  paymentTransactions PaymentTransaction[]

  @@unique([studentId, courseId])
  @@index([studentId, status])
  @@index([courseId, status])
  @@map("enrollments")
}

model LessonProgress {
  id              String       @id @default(uuid())
  enrollmentId    String
  lessonId        String
  progressSeconds Int          @default(0)
  completed       Boolean      @default(false)
  completedAt     DateTime?
  lastWatchedAt   DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  enrollment      Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson          CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId, completed])
  @@map("lesson_progresses")
}

model CourseReview {
  id           String      @id @default(uuid())
  courseId     String
  studentId    String
  enrollmentId String?
  rating       Int         @default(5) // 1-5
  review       String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([courseId, studentId])
  @@map("course_reviews")
}

model CourseCompletion {
  id            String     @id @default(uuid())
  enrollmentId  String     @unique
  completedAt   DateTime   @default(now())
  certificateId String?

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("course_completions")
}


model LiveClassSlot {
  id                   String    @id @default(uuid())
  teacherId            String
  title                String
  description          String?
  subject              String
  level                String    @default("ALL_LEVELS") // BEGINNER | INTERMEDIATE | ADVANCED | ALL_LEVELS
  language             String    @default("English")
  startTime            DateTime
  endTime              DateTime
  timezone             String    @default("Asia/Kolkata")
  durationMinutes      Int       @default(60)
  classType            String    @default("GROUP") // ONE_TO_ONE | GROUP
  maxCapacity          Int       @default(10)
  minimumStudents      Int       @default(1)
  price                Float     @default(0)
  status               String    @default("SCHEDULED") // DRAFT | SCHEDULED | OPEN | FULL | LIVE | COMPLETED | CANCELLED | BLOCKED | PENDING
  bookingOpenAt        DateTime?
  bookingCloseAt       DateTime?
  lockedUntil          DateTime?
  joinBeforeMinutes    Int       @default(10)
  bufferMinutes        Int       @default(15)
  cameraRequired       Boolean   @default(true)
  micRequired          Boolean   @default(true)
  screenSharingAllowed Boolean   @default(true)
  whiteboardAllowed    Boolean   @default(true)
  chatAllowed          Boolean   @default(true)
  fileSharingAllowed   Boolean   @default(true)
  relatedCourseId      String?
  isRecurring          Boolean   @default(false)
  recurrenceRule       String?   // DAILY | WEEKLY | JSON string

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  teacher              TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bookings             Booking[]
  session              LiveClassSession?
  paymentOrders        PaymentOrder[]
  paymentTransactions  PaymentTransaction[]

  @@index([status])
  @@index([teacherId, status])
  @@index([startTime, endTime])
  @@map("live_class_slots")
}

model TeacherAvailability {
  id        String   @id @default(uuid())
  teacherId String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String   // "09:00"
  endTime   String   // "17:00"
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, dayOfWeek, startTime, endTime])
  @@map("teacher_availabilities")
}

model TeacherDateOverride {
  id        String   @id @default(uuid())
  teacherId String
  date      String   // "YYYY-MM-DD"
  startTime String   // "09:00"
  endTime   String   // "10:00"
  type      String   @default("AVAILABLE") // AVAILABLE | BLOCKED
  reason    String?
  timezone  String   @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_date_overrides")
}

model TeacherBreak {
  id        String   @id @default(uuid())
  teacherId String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String   // "13:00"
  endTime   String   // "14:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_breaks")
}

model Booking {
  id              String   @id @default(uuid())
  liveClassSlotId String
  studentId       String
  status          String   @default("CONFIRMED") // CONFIRMED | CANCELLED | ATTENDED

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  liveClassSlot LiveClassSlot @relation(fields: [liveClassSlotId], references: [id], onDelete: Cascade)
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentTransactions PaymentTransaction[]

  @@index([studentId, status])
  @@index([liveClassSlotId, status])
  @@map("bookings")
}

model LiveClassSession {
  id               String   @id @default(uuid())
  liveClassSlotId  String   @unique
  teacherId        String
  roomId           String   @unique
  status           String   @default("SCHEDULED") // SCHEDULED | OPEN | LIVE | ENDED | CANCELLED
  scheduledStartAt DateTime
  scheduledEndAt   DateTime
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  durationMinutes  Int?
  studentCanDraw   Boolean  @default(false)
  whiteboardState  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  liveClassSlot LiveClassSlot       @relation(fields: [liveClassSlotId], references: [id], onDelete: Cascade)
  teacher       TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendances   ClassAttendance[]
  messages      ClassroomMessage[]
  files         ClassroomFile[]

  @@map("live_class_sessions")
}

model ClassAttendance {
  id        String    @id @default(uuid())
  sessionId String
  studentId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  duration  Int       @default(0)
  status    String    @default("ABSENT") // PRESENT | PARTIAL | ABSENT

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId, status])
  @@index([studentId])
  @@map("class_attendances")
}

model ClassroomMessage {
  id         String   @id @default(uuid())
  sessionId  String
  senderId   String
  senderName String
  senderRole String
  message    String
  createdAt  DateTime @default(now())

  session LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("classroom_messages")
}

model ClassroomFile {
  id         String   @id @default(uuid())
  sessionId  String
  uploadedBy String
  fileName   String
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  session  LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  uploader User             @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("classroom_files")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String    @default("INFO") // AUTH | TEACHER | LIVE_CLASS | COURSE | PAYMENT | SYSTEM | INFO | SUCCESS | WARNING
  data      String?   // JSON payload string
  actionUrl String?   // Redirect link on click
  linkUrl   String?   // Legacy alias
  isRead    Boolean   @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  emailCourseUpdates  Boolean  @default(true)
  emailClassReminders Boolean  @default(true)
  emailPaymentUpdates Boolean  @default(true)
  emailMarketing     Boolean  @default(false)
  inAppEnabled        Boolean  @default(true)
  browserEnabled      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String   // e.g. USER_REGISTERED, COURSE_ENROLLED, PAYMENT_CAPTURED
  entityType String?  // e.g. Course, LiveClassSlot, PaymentTransaction
  entityId   String?
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@map("activity_logs")
}


model PaymentOrder {
  id              String   @id @default(uuid())
  userId          String
  type            String   // LIVE_CLASS_BOOKING | COURSE_ENROLLMENT
  referenceId     String   // courseId or liveClassSlotId
  courseId        String?
  liveClassSlotId String?
  provider        String   @default("CASHFREE")
  providerOrderId String   @unique
  amountPaise     Int
  currency        String   @default("INR")
  status          String   @default("CREATED") // CREATED | PENDING | CAPTURED | FAILED | CANCELLED | EXPIRED
  receipt         String   @unique
  notes           String?  // JSON string
  expiresAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  liveClassSlot LiveClassSlot?       @relation(fields: [liveClassSlotId], references: [id], onDelete: SetNull)
  transactions  PaymentTransaction[]

  @@map("payment_orders")
}

model PaymentTransaction {
  id                 String    @id @default(uuid())
  userId             String
  orderId            String?
  type               String    // LIVE_CLASS_BOOKING | COURSE_ENROLLMENT
  status             String    @default("CREATED") // CREATED | PENDING | AUTHORIZED | CAPTURED | FAILED | REFUNDED | PARTIALLY_REFUNDED | CANCELLED | DISPUTED
  amountPaise        Int
  currency           String    @default("INR")
  provider           String    @default("CASHFREE")
  providerOrderId    String
  providerPaymentId  String?   @unique
  providerSignature  String?
  internalReference  String    @unique
  courseId           String?
  liveClassSlotId    String?
  bookingId          String?
  enrollmentId       String?
  paymentMethod      String?
  capturedAt         DateTime?
  failedAt           DateTime?
  failureReason      String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         PaymentOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  course        Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  liveClassSlot LiveClassSlot?         @relation(fields: [liveClassSlotId], references: [id], onDelete: SetNull)
  booking       Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  enrollment    Enrollment?            @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  ledgerEntries FinancialLedgerEntry[]
  refunds       Refund[]
  payouts       TeacherPayout[]

  @@index([userId, status])
  @@index([providerOrderId])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id           String    @id @default(uuid())
  provider     String    @default("CASHFREE")
  eventId      String
  eventType    String
  payloadHash  String?
  payload      String    // Raw JSON string
  processed    Boolean   @default(false)
  processedAt  DateTime?
  error        String?

  createdAt    DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model FinancialLedgerEntry {
  id            String    @id @default(uuid())
  transactionId String?
  teacherId     String?
  type          String    // PAYMENT | PLATFORM_COMMISSION | TEACHER_EARNING | REFUND | REFUND_REVERSAL | TRANSFER | ADJUSTMENT
  amountPaise   Int
  currency      String    @default("INR")
  direction     String    // CREDIT | DEBIT
  status        String    @default("COMPLETED") // PENDING | COMPLETED | REVERSED | CANCELLED
  description   String?

  createdAt     DateTime  @default(now())

  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  teacher       TeacherProfile?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  payouts       TeacherPayout[]
  withdrawals   WithdrawalRequest[]

  @@index([teacherId, type])
  @@index([type, status])
  @@map("financial_ledger_entries")
}

model TeacherPayoutAccount {
  id                String    @id @default(uuid())
  teacherId         String    @unique
  provider          String    @default("CASHFREE_SPLIT")
  providerAccountId String?   // Cashfree Vendor ID / Beneficiary ID
  accountName       String?
  accountType       String?   @default("STANDARD")
  upiId             String?
  status            String    @default("NOT_STARTED") // NOT_STARTED | PENDING | UNDER_REVIEW | ACTIVE | REJECTED
  onboardingUrl     String?
  kycStatus         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher           TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_payout_accounts")
}

model TeacherPayout {
  id                 String    @id @default(uuid())
  teacherId          String
  ledgerEntryId      String?
  transactionId      String?
  providerTransferId String?   @unique // Cashfree Transfer ID / Split ID
  amountPaise        Int
  currency           String    @default("INR")
  status             String    @default("PENDING") // PENDING | ELIGIBLE | PROCESSING | PAID | FAILED | ON_HOLD
  processedAt        DateTime?
  failureReason      String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teacher            TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  ledgerEntry        FinancialLedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  transaction        PaymentTransaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([teacherId, status])
  @@map("teacher_payouts")
}

model WithdrawalRequest {
  id                  String    @id @default(uuid())
  teacherId           String
  amountPaise         Int
  currency            String    @default("INR")
  status              String    @default("PENDING") // PENDING | APPROVED | REJECTED | PROCESSING | COMPLETED | FAILED
  payoutMethod        String    @default("BANK_TRANSFER") // BANK_TRANSFER | UPI
  
  // Beneficiary snapshot at request time
  accountHolderName   String?
  accountNumber       String?
  bankName            String?
  ifscCode            String?
  upiId               String?

  // Cashfree Payout transfer details
  providerTransferId  String?   @unique
  providerReferenceId String?   // UTR or Bank Reference
  
  adminNotes          String?
  rejectionReason     String?
  failureReason       String?
  
  requestedAt         DateTime  @default(now())
  approvedAt          DateTime?
  approvedBy          String?   // Admin User ID
  rejectedAt          DateTime?
  rejectedBy          String?   // Admin User ID
  processedAt         DateTime?
  completedAt         DateTime?
  failedAt            DateTime?

  idempotencyKey      String?   @unique

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  teacher             TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  ledgerEntryId       String?
  ledgerEntry         FinancialLedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  @@index([teacherId, status])
  @@index([status])
  @@map("withdrawal_requests")
}

model Refund {
  id               String    @id @default(uuid())
  transactionId   String
  providerRefundId String?   @unique // Razorpay Refund ID (rfnd_xxx)
  amountPaise      Int
  currency         String    @default("INR")
  reason           String?
  status           String    @default("REFUND_REQUESTED") // REFUND_REQUESTED | REFUND_PROCESSING | REFUNDED | REFUND_FAILED | PARTIALLY_REFUNDED
  requestedBy      String    // userId
  approvedBy       String?   // admin userId

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transaction      PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  requester        User               @relation("RefundRequestedBy", fields: [requestedBy], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_configs")
}

model CourseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("course_categories")
}

model Report {
  id           String    @id @default(uuid())
  reporterId   String
  targetType   String    // USER | TEACHER | COURSE | REVIEW | LIVE_CLASS | CONTENT
  targetId     String
  reason       String
  description  String?
  status       String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | REJECTED
  actionTaken  String?   // Details of admin moderation action taken
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter   User  @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

model CourseModerationHistory {
  id             String   @id @default(uuid())
  courseId       String
  adminId        String
  previousStatus String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  admin  User   @relation("CourseModerationAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("course_moderation_histories")
}

model PendingRegistration {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  role             String   @default("STUDENT") // ADMIN | TEACHER | STUDENT
  firstName        String
  lastName         String
  registrationData String?  // JSON string containing role-specific fields (headline, subjects, experienceYears, hourlyRate, qualifications, languages, teachingMode, gradeLevel, interests, learningPreferences, etc.)
  codeHash         String   // Hashed 6-digit OTP (SHA-256)
  tokenHash        String?  @unique // Hashed URL token for direct email click link
  expiresAt        DateTime
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@map("pending_registrations")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  isSystem    Boolean  @default(false)    // Predefined template/system roles
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy       User?            @relation("RolesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  users           User[]           @relation("UserRole")
  roleFeatures    RoleFeature[]
  rolePermissions RolePermission[]
  invitations     StaffInvitation[]

  @@map("roles")
}

model Feature {
  id                 String   @id @default(uuid())
  key                String   @unique // dashboard, courses, teachers, users, live_classes, payments, refunds, reports, analytics, activity, system_health, settings, roles, staff
  name               String
  description        String?
  moduleGroup        String   // Core | Academic | Finance | Governance | Operations | Administration
  route              String
  icon               String   // Lucide icon name
  sortOrder          Int      @default(0)
  status             String   @default("ACTIVE") // ACTIVE | INACTIVE
  parentFeatureId    String?
  dashboardWidgetKey String?

  parent       Feature?       @relation("FeatureHierarchy", fields: [parentFeatureId], references: [id], onDelete: Cascade)
  children     Feature[]      @relation("FeatureHierarchy")
  roleFeatures RoleFeature[]
  permissions  Permission[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("features")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // courses.view, courses.create, courses.update, courses.delete, courses.approve, etc.
  name        String
  description String?
  moduleGroup String
  action      String   // view, create, update, delete, approve, reject, manage, cancel, export, etc.
  featureId   String?
  sortOrder   Int      @default(0)

  feature         Feature?         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("permissions")
}

model RoleFeature {
  id        String   @id @default(uuid())
  roleId    String
  featureId String

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, featureId])
  @@map("role_features")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model StaffInvitation {
  id          String    @id @default(uuid())
  email       String
  fullName    String?
  roleId      String
  invitedById String
  status      String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("StaffInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@map("staff_invitations")
}

model EventRegistration {
  id             String   @id @default(uuid())
  name           String
  whatsappNumber String
  eventSlug      String   @default("educonnects-grand-opening")
  source         String   @default("LIVE_PAGE")
  status         String   @default("CONFIRMED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([eventSlug, whatsappNumber])
  @@index([eventSlug])
  @@map("event_registrations")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String?
  role      String      @default("guest") // ADMIN | EDUCATOR | LEARNER | guest
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // user | assistant | system
  content        String
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model Offer {
  id             String    @id @default(uuid())
  code           String?   @unique // e.g. "900FF", "EDU40"
  title          String
  description    String?
  discountText   String?   // e.g. "FLAT 40% OFF", "USE CODE: EDU40"
  discountType   String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue  Float     @default(0) // e.g. 90 (for 90%) or 500 (for ₹500)
  minOrderAmount Float?    // Minimum order value in ₹
  maxDiscount    Float?    // Maximum discount cap in ₹
  usageLimit     Int?      // Maximum redemptions allowed
  usedCount      Int       @default(0) // Current number of redemptions
  ctaText        String?   @default("Explore Now")
  ctaLink        String?   @default("/courses")
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  targetAudience String    @default("ALL") // ALL | MAIN | LEARNERS | EDUCATORS
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([isActive, startDate, endDate])
  @@map("offers")
}

model PromotionalBanner {
  id               String    @id @default(uuid())
  title            String
  subtitle         String?
  description      String?
  bannerType       String    @default("OFFER") // OFFER | PROMOTION | ANNOUNCEMENT | COURSE_PROMOTION | EVENT | GENERAL
  imageUrl         String
  imageClickUrl    String?
  imageClickTarget String    @default("_self") // _self | _blank
  ctaText          String?
  ctaUrl           String?
  placement        String    @default("ALL") // ALL | MAIN | LEARNERS | EDUCATORS
  displayOrder     Int       @default(0)
  startAt          DateTime?
  endAt            DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive])
  @@index([placement])
  @@index([startAt])
  @@index([endAt])
  @@index([displayOrder])
  @@map("promotional_banners")
}

model TrainingProgram {
  id           String               @id @default(uuid())
  slug         String               @unique @default("15-day-educator-training")
  title        String               @default("15-Day Educator Training Program")
  description  String?
  totalDays    Int                  @default(15)
  isSequential Boolean              @default(true)
  status       String               @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  days         TrainingDay[]
  enrollments  TrainingEnrollment[]

  @@map("training_programs")
}

model TrainingDay {
  id                 String                @id @default(uuid())
  programId          String
  dayNumber          Int
  title              String
  description        String?
  learningObjectives String?               // JSON string array of objectives
  instructions       String?
  videoAssetId       String?               // Mux asset ID
  videoPlaybackId    String?               // Mux playback ID
  videoDuration      Float?                // duration in seconds
  resources          String?               // JSON string of [{ name, url, type }]
  isPublished        Boolean               @default(false)
  orderIndex         Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  program            TrainingProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  quiz               TrainingQuiz?
  dayProgress        TrainingDayProgress[]

  @@unique([programId, dayNumber])
  @@index([programId, orderIndex])
  @@map("training_days")
}

model TrainingQuiz {
  id            String                @id @default(uuid())
  dayId         String                @unique
  title         String
  description   String?
  passingScore  Int                   @default(70) // Percentage required to pass
  questionCount Int                   @default(5)
  maxAttempts   Int                   @default(3) // 0 for unlimited, or e.g. 3
  isPublished   Boolean               @default(false)
  questions     String                // JSON array of [{ id, questionNumber, question, options: [{ key, text }], correctAnswer, explanation }]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  day           TrainingDay           @relation(fields: [dayId], references: [id], onDelete: Cascade)
  attempts      TrainingQuizAttempt[]

  @@map("training_quizzes")
}

model TrainingEnrollment {
  id                   String                @id @default(uuid())
  programId            String
  userId               String
  status               String                @default("ENROLLED") // ENROLLED | IN_PROGRESS | COMPLETED | CERTIFICATE_ELIGIBLE | CERTIFIED
  currentDay           Int                   @default(1)
  completedDaysCount   Int                   @default(0)
  completionPercentage Float                 @default(0.0)
  startDate            DateTime              @default(now())
  completedAt          DateTime?
  certificateEligibleAt DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  program              TrainingProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayProgress          TrainingDayProgress[]
  quizAttempts         TrainingQuizAttempt[]
  certificate          Certificate?

  @@unique([programId, userId])
  @@index([userId, status])
  @@map("training_enrollments")
}

model TrainingDayProgress {
  id                    String             @id @default(uuid())
  enrollmentId          String
  dayId                 String
  dayNumber             Int
  videoWatched          Boolean            @default(false)
  videoWatchTimeSeconds Float              @default(0)
  contentCompleted      Boolean            @default(false)
  quizPassed            Boolean            @default(false)
  bestScore             Float?
  isCompleted           Boolean            @default(false)
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  enrollment            TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  day                   TrainingDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, dayId])
  @@index([enrollmentId, dayNumber])
  @@map("training_day_progress")
}

model TrainingQuizAttempt {
  id             String             @id @default(uuid())
  enrollmentId   String
  quizId         String
  attemptNumber  Int
  totalQuestions Int
  correctAnswers Int
  scorePercentage Float
  passed         Boolean
  answers        String             // JSON string of user submitted answers
  submittedAt    DateTime           @default(now())

  enrollment     TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quiz           TrainingQuiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, quizId])
  @@map("training_quiz_attempts")
}

model CertificateTemplate {
  id             String        @id @default(uuid())
  title          String        @default("15-Day Educator Certification Template")
  badgeText      String        @default("VERIFIED EDUCATOR")
  headline       String        @default("Certificate of Completion")
  subtext        String        @default("This is proudly presented to")
  bodyText       String        @default("For successfully completing the intensive 15-Day Educator Training Program, demonstrating mastery of live interactive classroom delivery, digital curriculum design, and online pedagogical excellence.")
  issuerName     String        @default("EduConnects Academy")
  issuerTitle    String        @default("Director of Academic Excellence")
  primaryColor   String        @default("#16805B")
  accentColor    String        @default("#0D5C41")
  orientation    String        @default("LANDSCAPE") // LANDSCAPE | PORTRAIT
  namePlacementY Float         @default(300)
  idPlacementY   Float         @default(120)
  datePlacementY Float         @default(120)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  certificates   Certificate[]

  @@map("certificate_templates")
}

model Certificate {
  id                String               @id @default(uuid())
  certificateNumber String               @unique // e.g. EDU-CERT-2026-XXXXXX
  enrollmentId      String               @unique // 1-to-1 with TrainingEnrollment
  templateId        String?
  userId            String
  educatorName      String               // Verified educator name
  educatorEmail     String               // Verified educator email
  programTitle      String               @default("15-Day Educator Training Program")
  completionDate    DateTime             @default(now())
  issueDate         DateTime             @default(now())
  pdfUrl            String?
  status            String               @default("ISSUED") // ISSUED | REVOKED
  revokedAt         DateTime?
  revocationReason  String?
  regeneratedAt     DateTime?
  regenerationCount Int                  @default(0)
  emailSentAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  enrollment        TrainingEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  template          CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs         CertificateAuditLog[]

  @@index([certificateNumber])
  @@index([userId])
  @@index([status])
  @@map("certificates")
}

model CertificateAuditLog {
  id            String      @id @default(uuid())
  certificateId String
  action        String      // GENERATED | EMAILED | RESENT | REVOKED | REGENERATED | VERIFIED_VIEWED
  performedById String?     // Admin User ID or "SYSTEM" or "EDUCATOR"
  details       String?
  ipAddress     String?
  createdAt     DateTime    @default(now())

  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("certificate_audit_logs")
}

model WhatsAppMessage {
  id              String    @id @default(uuid())
  userId          String?
  phoneNumber     String
  eventType       String    // e.g. PAYMENT_SUCCESS, REFUND_REQUESTED, etc.
  templateName    String
  parameters      String?   // JSON string of template parameter values
  metaMessageId   String?   @unique // WAMID from Meta Cloud API
  status          String    @default("PENDING") // SENT | DELIVERED | READ | FAILED | PENDING
  errorMessage    String?
  idempotencyKey  String?   @unique
  metadata        String?   // JSON string for additional context
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([phoneNumber])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_messages")
}


